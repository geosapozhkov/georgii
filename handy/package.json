{
  "name": "handy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Handy is a free open-source creative studio for layout, 3D form, rendering, print color, animation, and playable scenes.",
  "scripts": {
    "start": "vite --host",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/outfit": "^5.2.8",
    "immer": "^10.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
